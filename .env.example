# URL publique du site (utilisée pour le SEO, le sitemap et les balises Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.aqdoulum.com

# Envoi des demandes de devis par e-mail via Resend (https://resend.com) — optionnel.
# Sans ces variables, le formulaire fonctionne et les demandes sont visibles dans les logs Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=steaqdoulum@gmail.com
CONTACT_FROM_EMAIL=AQDOULUM <site@aqdoulum.com>
